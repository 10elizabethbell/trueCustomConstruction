      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-chip{position:relative}.ds-chip input{position:absolute;opacity:0;width:1px;height:1px}.ds-chip span{display:flex;align-items:center;min-height:48px;padding:0 16px;border:2px solid #8C958F;border-radius:10px;background:#FBFCFA;color:#1F2B33;font-weight:700;cursor:pointer;transition:border-color .15s ease-out,background-color .15s ease-out}.ds-chip:hover span{border-color:#2F6FB0}.ds-chip input:focus-visible+span{border-color:#2F6FB0;box-shadow:0 0 0 3px rgba(47,111,176,.25)}.ds-chip input:checked+span{background:#1F2B33;border-color:#1F2B33;color:#ECEDE9}"
