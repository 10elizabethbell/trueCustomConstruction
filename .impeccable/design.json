  "narrative": {
    "northStar": "The Soil Cutaway",
    "overview": "A yard crew's site drawn as a cross-section of the job: overcast sky, topsoil over rocky clay, a dark board-and-batten wall, and their yellow tracked skid steer. Light concrete sections and charcoal-blue slate sections alternate, stitched by live sod strips. Heavy uppercase system sans names things; sentence case speaks. Surfaces are flat; the canvases carry all depth.",
    "keyCharacteristics": [
      "Two grounds: concrete and slate, joined by sod strips",
      "Heavy uppercase system-sans display, sentence-case body",
      "Yellow reserved for primary action and the machine",
      "Flat UI; shadows only for focus",
      "Two canvas scenes carry the world"
    ],
    "rules": [
      {
        "name": "The Machine Yellow Rule",
        "body": "Yellow is the machine and the primary action; never a band, heading color, or decoration.",
        "section": "colors"
      },
      {
        "name": "The Two Grounds Rule",
        "body": "Every section is concrete or slate; no third section color, no black ground.",
        "section": "colors"
      },
      {
        "name": "The Soil Stays Underground Rule",
        "body": "Topsoil, clay and turf live in canvases and sod strips, not UI components.",
        "section": "colors"
      },
      {
        "name": "The Names Shout, Sentences Talk Rule",
        "body": "Uppercase 900 for headings, service rows and the wordmark; everything else sentence case.",
        "section": "typography"
      },
      {
        "name": "The Balanced Heading Rule",
        "body": "Headings use text-wrap: balance and line-height of 1 or less.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "UI is flat at rest; shadows mean focus or belong to the drawn world.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do alternate concrete and slate with a sod strip at every change.",
      "Do keep controls 48px or taller (buttons 56, inputs 54, chips 48).",
      "Do use water blue for every focus and edit-hover signal.",
      "Do keep canvas tuning in T and business facts in BIZ.",
      "Do give every canvas a reduced-motion still and a no-JS fallback."
    ],
    "donts": [
      "Don't use yellow beyond the primary action and the machine.",
      "Don't add resting shadows, UI gradients, a third section color, or a black ground.",
      "Don't uppercase body copy, buttons or labels.",
      "Don't reuse the wordmark's tracked subline as an eyebrow above headings.",
      "Don't add hover backgrounds to service rows.",
      "Don't put rain or animation over the desktop hero copy column."
    ]
  }
}