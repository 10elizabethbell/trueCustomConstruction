      "css": ".ds-rows{list-style:none;margin:0;padding:0;border-top:1px solid #C5CBC6;background:#ECEDE9;color:#1F2B33}.ds-row{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:76px;padding:12px 0;border-bottom:1px solid #C5CBC6;text-decoration:none;color:inherit;font:900 30px/1.05 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;text-transform:uppercase;letter-spacing:-.01em;outline:none}.ds-arrow{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#DFE2DD;transition:background-color .18s ease-out}.ds-row:hover .ds-arrow,.ds-row:focus-visible .ds-arrow{background:#F2B417}.ds-row:focus-visible .ds-arrow{outline:3px solid #2F6FB0;outline-offset:3px}"
    },
